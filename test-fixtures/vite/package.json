{
  "name": "vite-plugin-bundle-obfuscator-compatibility-test",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:lib",
    "build:esm": "vite build --config vite.config.mjs --outDir dist/esm",
    "build:cjs": "vite build --config vite.config.cjs --outDir dist/cjs",
    "build:lib": "node library.mjs && node watch.mjs",
    "build:browser": "node browser-build.mjs",
    "test:browser": "playwright test --config playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
